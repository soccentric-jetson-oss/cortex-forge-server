#
# Full DOT integration: call graphs, caller graphs, collaboration,
# include graphs, directory graphs, and UML-style class diagrams.

PROJECT_NAME           = "Cortex Forge Server"
PROJECT_NUMBER         = 0.1.0
PROJECT_BRIEF          = "gRPC server for ML inference on Jetson AGX Orin accelerators"
OUTPUT_DIRECTORY       = docs/html
CREATE_SUBDIRS         = YES
INPUT                  = src/ proto/
RECURSIVE              = YES
FILE_PATTERNS          = *.cpp *.hpp *.proto
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
HTML_DYNAMIC_SECTIONS  = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES

# ── DOT integration ──────────────────────────────────────────────────────
HAVE_DOT               = YES
DOT_NUM_THREADS        = 4
DOT_FONTNAME           = Helvetica
DOT_FONTSIZE           = 10
DOT_GRAPH_MAX_DEPTH    = 3
DOT_IMAGE_FORMAT       = svg
DOT_CLEANUP            = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
UML_LOOK               = YES
UML_LIMIT_NUM_FIELDS   = 10
TEMPLATE_RELATIONS     = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DIRECTORY_GRAPH        = YES
CLASS_DIAGRAMS         = YES
CLASS_GRAPH            = YES
DOT_TRANSPARENT        = YES
DOT_MULTI_TARGETS      = YES
MAX_DOT_GRAPH_DEPTH    = 3
DOT_WRAP_THRESHOLD     = 5

# ── Warnings ────────────────────────────────────────────────────────────
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
WARN_FORMAT            = "$file:$line: $text"
