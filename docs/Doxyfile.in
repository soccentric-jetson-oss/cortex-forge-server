PROJECT_NAME = "Cortex Forge Server"
PROJECT_NUMBER = 0.1.0

DOXYFILE_ENCODING = UTF-8
OUTPUT_DIRECTORY = @CMAKE_CURRENT_SOURCE_DIR@/docs/html
INPUT = @CMAKE_CURRENT_SOURCE_DIR@/src @CMAKE_CURRENT_SOURCE_DIR@/docs/mainpage.md
FILE_PATTERNS = *.hpp *.cpp *.md
RECURSIVE = YES
EXTRACT_ALL = YES
EXTRACT_PRIVATE = NO
EXTRACT_STATIC = NO
GENERATE_HTML = YES
GENERATE_LATEX = NO
HTML_DYNAMIC_SECTIONS = YES
